# Configure como variáveis de ambiente do Windows (veja README). NUNCA suba valores reais.
# Todos os valores abaixo são fictícios.

# Pasta (sincronizada ou local) onde ficam as notas
NOTAS_PASTA_BASE=C:\Users\SEU_USUARIO\Pasta\Notas Fiscais

# CNPJ da própria empresa (tomadora) - obrigatório
EMPRESA_CNPJ=00.000.000/0001-00

# Bloqueio por nome quando não há CNPJ legível (grupos "|", termos "+", sem acentos, minúsculo)
EMPRESA_TERMOS_BLOQUEIO=minhaempresa+matriz|minhaempresa+filial

# Arquivos a ignorar (separados por vírgula, minúsculo)
ARQUIVOS_IGNORADOS=comprovante-interno.pdf,manual.pdf

# true = só simula, false = renomeia de verdade
DRY_RUN=true

# Grava o texto completo das notas em disco (contém dados pessoais). Use só para depurar.
SALVAR_DEBUG=false
